import os
import threading
from flask import Flask
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes

TOKEN = os.getenv("BOT_TOKEN", "8849122687:AAEK6k4q8QMW__AJ3sXSgzc-4nZRej4D-PQ").strip()
print(f"TOKEN LENGTH: {len(TOKEN)}", flush=True)

app = Flask(__name__)

@app.route('/')
def home():
    return "Bot is Live! V2 - Mastermind - OK"

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("🔥 MASTERMIND V2 LIVE! Iko sawa!\n\nAndika /help")

async def help_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Commands:\n/start - Anza\n/help - Msaada\n/slip - Slip")

async def slip(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("🎯 Slip ya leo inakuja...")

def run_bot():
    try:
        print("BOT THREAD INAANZA...", flush=True)
        application = ApplicationBuilder().token(TOKEN).build()
        application.add_handler(CommandHandler("start", start))
        application.add_handler(CommandHandler("help", help_cmd))
        application.add_handler(CommandHandler("slip", slip))
        print("Polling...", flush=True)
        application.run_polling(drop_pending_updates=True)
    except Exception as e:
        print(f"BOT ERROR: {e}", flush=True)
        import traceback
        traceback.print_exc()

threading.Thread(target=run_bot, daemon=True).start()

if __name__ == "__main__":
    port = int(os.environ.get("PORT", 10000))
    app.run(host="0.0.0.0", port=port)
